# Rakazo API as seen from the containers (the web app proxies it; the API port is enough)
RAKAZO_API_URL=http://host.docker.internal:3311

# LiveKit: the SFU as seen from the worker, and as the browser reaches it (wss behind your proxy)
LIVEKIT_URL=ws://host.docker.internal:7880
LIVEKIT_PUBLIC_URL=wss://lk.example.com
LIVEKIT_API_KEY=rakazo-voice
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=rakazo-voice

# Shared between token server and agent; the agent fetches the caller's bearer with it
VOICE_INTERNAL_TOKEN=

# Speech
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=flux-general-en      # or nova-3
DEEPGRAM_TTS_VOICE=aura-2-orion-en
TTS_PROVIDER=deepgram                   # deepgram | kokoro
KOKORO_BASE_URL=http://kokoro-tts:8880/v1
KOKORO_VOICE=af_heart
VOICE_GREETING=Connected. Go ahead.

# Optional fallback identity for rooms created without the token server (livekit-cli tests)
RAKAZO_EMAIL=
RAKAZO_PASSWORD=
RAKAZO_BOT_NAME=Voice
